            "cl": "0x0201",
            "at": "0x0000",
            "eval": "if (Attr.val != -32768) { Item.val = Attr.val; }"
          }
        },
        {
          "name": "config/heatsetpoint",
          "range": [
            700,
            3200
          ],
          "default": 700,
