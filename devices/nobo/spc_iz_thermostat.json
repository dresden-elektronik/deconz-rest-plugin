            "ep": 1,
            "cl": "0x0201",
            "at": "0x001C"
          },
          "parse": {
            "fn": "zcl:attr",
            "ep": 1,
            "cl": "0x0201",
            "at": "0x001C",
            "eval": "if (Attr.val == 0) { Item.val = 'off'; } else if (Attr.val == 4) { Item.val = 'heat'; }"
          },
          "write": {
            "fn": "zcl:attr",
            "ep": 1,
            "cl": "0x0201",
            "at": "0x001C",
            "dt": "0x30",
            "eval": "if (Item.val == 'off') { 0; } else if (Item.val == 'heat') { 4; }"
          }
        }
