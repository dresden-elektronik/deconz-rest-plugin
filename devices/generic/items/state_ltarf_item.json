{
    "schema": "resourceitem1.schema.json",
    "id": "state/ltarf",
    "datatype": "String",
    "access": "R",
    "public": true,
    "description": "ZLinky ltarf",
    "read": {
        "at": "0x0200",
        "cl": "0xff66",
        "ep": 1,
        "fn": "zcl:attr"
    },
    "parse": {
        "at": "0x0200",
        "cl": "0xff66",
        "ep": 1,
        "eval": "Item.val = Attr.val",
        "fn": "zcl:attr"
    },
    "refresh.interval": 730
}
