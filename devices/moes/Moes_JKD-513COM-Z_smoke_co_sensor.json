          "name": "attr/uniqueid"
        },
        {
          "name": "state/test",
          "parse": {
            "fn": "tuya",
            "dpid": 9,
            "eval": "Item.val = Attr.val == 0"
          },
          "read": {
            "fn": "none"
          }
        },
        {
          "name": "state/alert",
          "write": {
            "fn": "tuya",
            "dpid": 16,
            "dt": "0x01",
            "eval": "Item.val == 'none' ? 1 : 0;"
          },
          "parse": {
            "fn": "tuya",
            "dpid": 16,
            "eval": "Item.val = (Attr.val == 1 ? 'none' : 'lselect');"
          },
          "read": {
            "fn": "tuya"
          },
		  "refresh.interval": 86400,
          "default": "lselect"
        },
        {
          "name": "state/reachable"
        },
        {
          "name": "state/lowbattery",
          "parse": {
            "fn": "tuya",
            "dpid": 14,
            "eval": "Item.val = Attr.val == 0"
          },
          "read": {
            "fn": "none"
          },
          "default": false
        },
		{
          "name": "state/errorcode",
          "parse": {
            "fn": "tuya",
			"dpid": 11,
			"eval": "var v = Number(Attr.val) || 0; var labels = ['fault', 'serious_fault', 'sensor_fault', 'probe_fault', 'power_fault']; var out = []; for (var i = 0; i < labels.length; i++) { if ((v & (1 << i)) !== 0) { out.push(labels[i]); } } Item.val = out.length ? out.join(',') : 'none';"
          },
          "read": {
            "fn": "none"
          },
          "default": "none"
        }
      ]
    },
