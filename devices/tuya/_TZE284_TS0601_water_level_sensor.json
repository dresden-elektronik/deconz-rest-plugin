          },
          "parse": {
            "dpid": 101,
            "eval": "if (Attr.val) { Item.val = 'supply' } else { Item.val = 'drainage' }",
            "fn": "tuya"
          }
        },
        {
          "name": "config/mode",
          "description": "Pump control",
          "values": [
            [
              "auto",
              true
            ],
            [
              "manual",
              false
            ]
          ],
          "read": { "fn": "none" },
          "write": {
            "dpid": 102,
            "dt": "0x10",
            "eval": "Item.val == 'auto'",
            "fn": "tuya"
          },
          "parse": {
            "dpid": 102,
            "eval": "if (Attr.val) { Item.val = 'auto' } else { Item.val = 'manual' }",
            "fn": "tuya"
          }
        },
