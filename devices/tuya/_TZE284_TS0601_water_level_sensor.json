            ],
            [
              "off",
              false
            ]
          ],
          "read": { "fn": "none" },
          "write": {
            "dpid": 24,
            "dt": "0x10",
            "eval": "Item.val == 'on'",
            "fn": "tuya"
          },
          "parse": {
            "dpid": 24,
            "eval": "if (Attr.val) { Item.val = 'on' } else { Item.val = 'off' }",
            "fn": "tuya"
          }
        },
        {
          "name": "state/alarm",
          "description": "Low liquid level alarm",
          "read": { "fn": "none" },
          "parse": {
            "dpid": 1,
            "eval": "Item.val = (Attr.val == 1);",
            "fn": "tuya"
          },
          "default": false
        },
        {
          "name": "state/levelstatus",
          "description": "Liquid level status",
          "values": [
            [
              "low",
              1
            ],
            [
              "normal",
              0
            ],
            [
              "high",
              2
            ]
          ],
          "read": { "fn": "none" },
          "parse": {
            "dpid": 1,
            "eval": "if (Attr.val == 0) { Item.val = 'normal' } else if (Attr.val == 1) { Item.val = 'low' } else if (Attr.val == 2) { Item.val = 'high' }",
            "fn": "tuya"
          }
        },
        {
          "name": "state/height",
          "description": "Liquid level depth (cm)",
          "read": { "fn": "none" },
          "parse": {
